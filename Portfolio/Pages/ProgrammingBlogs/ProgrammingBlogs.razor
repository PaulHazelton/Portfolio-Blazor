@using Portfolio.SharedComponents
@attribute [Route(Routes.BlogList)]

<PageTitle>Paul | Blogs</PageTitle>

<div class="reading-pane">
	<h1>My Programming Blogs</h1>

	<p>
		I'm a very opinionated programmer with a passion for type safety.
		I spend most of my day in C#, and I was super excited to learn about the
		<ExternalLink Href="https://learn.microsoft.com/en-us/dotnet/csharp/language-reference/builtin-types/nullable-reference-types">nullable reference types</ExternalLink>
		feature. It was not a smooth transition for me or my team to start using it with Blazor and EF Core however, so I was inspired to start writing down some code style guidelines for it's use.
		So I put it on my website to I could easily share my thoughts with some friends and coworkers. You're welcome to read my thoughts here.
	</p>

	<div class="blog-preview-list-container">
		@if (BlogPreviews is null)
		{
			<h1>LOADING</h1>
		}
		else
		{
			@foreach (var blogData in BlogPreviews)
			{
				<BlogPreviewItem BlogPreview=blogData />
			}
		}
	</div>
</div>